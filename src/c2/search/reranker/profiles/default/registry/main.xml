<?xml version="1.0" encoding="utf-8"?>
<registry xmlns:i18n="http://xml.zope.org/namespaces/i18n"
          i18n:domain="c2.search.reranker"
>

  <records interface="c2.search.reranker.interfaces.IRerankerSettings">
