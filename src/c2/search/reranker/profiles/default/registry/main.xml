    <value key="keyword_search_ratio">50</value>
    <value key="scoring_mode">rrf</value>
    <value key="group_general_content_types" />
    <value key="group_general_boost">1.0</value>
    <value key="group_general_halflife">60</value>
    <value key="group_announcements_content_types" />
    <value key="group_announcements_boost">1.0</value>
    <value key="group_announcements_halflife">60</value>
    <value key="group_knowledge_content_types" />
    <value key="group_knowledge_boost">1.0</value>
    <value key="group_knowledge_halflife">60</value>
    <value key="group_other_content_types" />
    <value key="group_other_boost">1.0</value>
    <value key="group_other_halflife">60</value>
  </records>

</registry>
