<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:zcml="http://namespaces.zope.org/zcml"
    i18n_domain="c2.search.reranker"
    >

  <browser:page
      name="reranker-search"
      for="Products.CMFPlone.interfaces.IPloneSiteRoot"
      class=".search.RerankerSearchView"
      template="templates/reranker_search.pt"
      permission="cmf.ManagePortal"
      />

  <browser:page
      name="hybrid-search"
      for="Products.CMFPlone.interfaces.IPloneSiteRoot"
      class=".hybrid_search.HybridSearchView"
      template="templates/hybrid_search.pt"
      permission="cmf.ManagePortal"
      />

  <!-- Override classic @@search and @@ajax-search with reranking.
       Plone 6+ uses plone.base.interfaces.INavigationRoot;
       Plone 5.2 falls back to IPloneSiteRoot. -->
  <configure zcml:condition="installed plone.base">
    <browser:page
        name="search"
        for="plone.base.interfaces.INavigationRoot"
        class=".search_override.RerankedSearch"
        permission="zope2.View"
        layer="c2.search.reranker.interfaces.IBrowserLayer"
        />

    <browser:page
        name="ajax-search"
        for="plone.base.interfaces.INavigationRoot"
        class=".search_override.RerankedAjaxSearch"
        permission="zope2.View"
        layer="c2.search.reranker.interfaces.IBrowserLayer"
        />
  </configure>

  <configure zcml:condition="not-installed plone.base">
    <!-- Plone 5.2: original @@search is registered for
         plone.app.layout.navigation.interfaces.INavigationRoot,
         so we must use the same interface to override it. -->
    <browser:page
        name="search"
        for="plone.app.layout.navigation.interfaces.INavigationRoot"
        class=".search_override.RerankedSearch"
        permission="zope2.View"
        layer="c2.search.reranker.interfaces.IBrowserLayer"
        />

    <browser:page
        name="ajax-search"
        for="plone.app.layout.navigation.interfaces.INavigationRoot"
        class=".search_override.RerankedAjaxSearch"
        permission="zope2.View"
        layer="c2.search.reranker.interfaces.IBrowserLayer"
        />
  </configure>

</configure>
