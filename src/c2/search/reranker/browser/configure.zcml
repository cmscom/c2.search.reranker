<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    i18n_domain="c2.search.reranker"
    >

  <browser:page
      name="reranker-search"
      for="Products.CMFPlone.interfaces.IPloneSiteRoot"
      class=".search.RerankerSearchView"
      template="templates/reranker_search.pt"
      permission="cmf.ManagePortal"
      />

  <browser:page
      name="hybrid-search"
      for="Products.CMFPlone.interfaces.IPloneSiteRoot"
      class=".hybrid_search.HybridSearchView"
      template="templates/hybrid_search.pt"
      permission="cmf.ManagePortal"
      />

  <!-- Override classic @@search and @@ajax-search with reranking.
       Use plone.app.layout INavigationRoot which works on both
       Plone 5.2 and Plone 6 (deprecated but functional on 6). -->
  <browser:page
      name="search"
      for="plone.app.layout.navigation.interfaces.INavigationRoot"
      class=".search_override.RerankedSearch"
      permission="zope2.View"
      layer="c2.search.reranker.interfaces.IBrowserLayer"
      />

  <browser:page
      name="ajax-search"
      for="plone.app.layout.navigation.interfaces.INavigationRoot"
      class=".search_override.RerankedAjaxSearch"
      permission="zope2.View"
      layer="c2.search.reranker.interfaces.IBrowserLayer"
      />

</configure>
