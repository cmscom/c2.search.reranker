<html metal:use-macro="context/main_template/macros/master"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal">
<body>

<metal:main fill-slot="content-core">

  <h1>Reranker Search (Test Page)</h1>

  <form method="GET" action=""
        tal:attributes="action string:${context/absolute_url}/@@reranker-search">
    <label for="SearchableText">Search:</label>
    <input type="text" name="SearchableText" id="SearchableText"
           size="40"
           tal:attributes="value view/search_text" />
    <input type="submit" value="Search" />
  </form>

  <div tal:condition="view/error" style="color: red; margin: 1em 0;">
    <strong>Error:</strong>
    <span tal:content="view/error" />
  </div>

  <div tal:condition="python: view.search_text and not view.results and not view.error"
       style="margin: 1em 0;">
    <p>No results found.</p>
  </div>

  <div tal:condition="view/results">
    <p>
      <strong tal:content="python: len(view.results)" /> results
      for "<span tal:content="view/search_text" />"
    </p>

    <table class="listing" style="width: 100%; border-collapse: collapse;">
      <thead>
        <tr>
          <th>#</th>
          <th>Title</th>
          <th>Type</th>
          <th>Modified</th>
          <th>Age (days)</th>
          <th>Original Score</th>
          <th>Boost</th>
          <th>Decay</th>
          <th>Final Score</th>
        </tr>
      </thead>
      <tbody>
        <tr tal:repeat="item view/results">
          <td tal:content="item/rank" />
          <td>
            <a tal:attributes="href item/url"
               tal:content="item/title" />
          </td>
          <td tal:content="item/portal_type" />
          <td tal:content="item/modified" />
          <td tal:content="item/age_days" style="text-align: right;" />
          <td tal:content="item/original_score" style="text-align: right;" />
          <td tal:content="item/boost" style="text-align: right;" />
          <td tal:content="item/decay" style="text-align: right;" />
          <td tal:content="item/final_score" style="text-align: right;" />
        </tr>
      </tbody>
    </table>
  </div>

</metal:main>

</body>
</html>
